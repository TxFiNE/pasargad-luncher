{
  "name": "pasargad-launcher",
  "version": "1.3.1",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "team.pasargad.launcher",
    "productName": "Pasargad Launcher",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "Pasargad-Launcher-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Pasargad-Launcher-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release",
        "owner": "txfine",
        "repo": "pasargad-luncher"
      }
    ]
  },
  "description": "Pasargad Team CS:GO Launcher",
  "author": "Pasargad Team",
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}